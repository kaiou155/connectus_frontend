# Copie para .env e ajuste conforme o ambiente.

# true  = usa o back-end simulado no navegador (dados de demonstração)
# false = chama a API real do back-end Node.js
VITE_USE_MOCK=true

# URL base da API. Em desenvolvimento, "/api" passa pelo proxy do Vite (ver VITE_API_PROXY).
# Em produção, aponte para o domínio HTTPS do back-end, ex.: https://api.conectus.app/api
VITE_API_URL=/api

# Endereço do back-end usado pelo proxy do Vite durante o desenvolvimento (npm run dev)
VITE_API_PROXY=http://localhost:3333

# Intervalo (ms) de atualização da ocupação das células nas telas de triagem (RF03)
VITE_POLLING_MS=15000

# "browser" (padrão) ou "hash" — use "hash" ao hospedar em locais sem fallback de rotas
VITE_ROUTER_MODE=browser
